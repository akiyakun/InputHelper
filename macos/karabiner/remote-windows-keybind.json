{
  "title": "Remote Windows Keybind - Windows App",
  "rules": [
    {
      "description": "Windows App: Cmd to Ctrl (disabled while using Synergy)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "left_control" }],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["^com\\.microsoft\\.rdc\\.macos$"]
            },
            {
              "type": "variable_unless",
              "name": "customenter_synergy_windows",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "right_control" }],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["^com\\.microsoft\\.rdc\\.macos$"]
            },
            {
              "type": "variable_unless",
              "name": "customenter_synergy_windows",
              "value": 1
            }
          ]
        }
      ]
    }
  ]
}
