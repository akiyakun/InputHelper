{
  "title": "CustomEnter - Enter newline for ChatGPT and Claude",
  "rules": [
    {
      "description": "CustomEnter: ChatGPT - Enter newline, Ctrl+Enter send (v2: disabled while using Synergy)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "return_or_enter",
            "modifiers": {
              "mandatory": [
                "control"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "return_or_enter",
              "repeat": false
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.openai\\.codex$"
              ]
            },
            {
              "type": "variable_unless",
              "name": "customenter_synergy_windows",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "return_or_enter",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "return_or_enter",
              "modifiers": [
                "left_shift"
              ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.openai\\.codex$"
              ]
            },
            {
              "type": "variable_unless",
              "name": "customenter_synergy_windows",
              "value": 1
            }
          ]
        }
      ]
    },
    {
      "description": "CustomEnter: Claude - Enter newline, Ctrl+Enter send (v2: disabled while using Synergy)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "return_or_enter",
            "modifiers": {
              "mandatory": [
                "control"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "return_or_enter",
              "repeat": false
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.anthropic\\.claudefordesktop$"
              ]
            },
            {
              "type": "variable_unless",
              "name": "customenter_synergy_windows",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "return_or_enter",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "return_or_enter",
              "modifiers": [
                "left_shift"
              ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.anthropic\\.claudefordesktop$"
              ]
            },
            {
              "type": "variable_unless",
              "name": "customenter_synergy_windows",
              "value": 1
            }
          ]
        }
      ]
    }
  ]
}
