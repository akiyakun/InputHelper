{
  "title": "Remote IME - Synergy and Chrome Remote Desktop",
  "rules": [
    {
      "description": "Synergy: Cmd tap IME off/on (v7: isolate Mac app rules, PowerToys Ctrl+Shift+9/0)",
      "manipulators": [
        {
          "type": "basic",
          "description": "Pass plain Enter through while controlling Windows; bypass Mac app Enter rules",
          "from": {
            "key_code": "return_or_enter",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "return_or_enter"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "customenter_synergy_windows",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "left_command",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_command",
              "lazy": true
            }
          ],
          "to_if_alone": [
            {
              "key_code": "9",
              "modifiers": [
                "left_command",
                "left_shift"
              ]
            },
            {
              "key_code": "vk_none"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "customenter_synergy_windows",
              "value": 1
            }
          ],
          "description": "Cmd tap: IME OFF via PowerToys; Synergy maps Mac Command to Windows Ctrl"
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_command",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "right_command",
              "lazy": true
            }
          ],
          "to_if_alone": [
            {
              "key_code": "0",
              "modifiers": [
                "left_command",
                "left_shift"
              ]
            },
            {
              "key_code": "vk_none"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "customenter_synergy_windows",
              "value": 1
            }
          ],
          "description": "Cmd tap: IME ON via PowerToys; Synergy maps Mac Command to Windows Ctrl"
        },
        {
          "type": "basic",
          "description": "Pass modified Cmd through; bypass Mac app IME rules",
          "from": {
            "key_code": "left_command",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_command"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "customenter_synergy_windows",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "description": "Pass modified Cmd through; bypass Mac app IME rules",
          "from": {
            "key_code": "right_command",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "right_command"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "customenter_synergy_windows",
              "value": 1
            }
          ]
        }
      ]
    },
    {
      "description": "Chrome Remote Desktop: Cmd tap IME off/on (v3: disabled while using Synergy)",
      "manipulators": [
        {
          "type": "basic",
          "description": "left Cmd tap: Microsoft IME off (on, then toggle)",
          "from": {
            "key_code": "left_command",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_command",
              "lazy": true
            }
          ],
          "to_if_alone": [
            {
              "key_code": "caps_lock",
              "modifiers": [
                "left_control"
              ],
              "hold_down_milliseconds": 100
            },
            {
              "key_code": "vk_none"
            },
            {
              "key_code": "caps_lock",
              "modifiers": [
                "left_control"
              ],
              "hold_down_milliseconds": 100
            },
            {
              "key_code": "vk_none"
            },
            {
              "key_code": "grave_accent_and_tilde",
              "modifiers": [
                "left_option"
              ],
              "hold_down_milliseconds": 100
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome\\.app\\.cmkncekebbebpfilplodngbpllndjkfo$"
              ]
            },
            {
              "type": "variable_unless",
              "name": "customenter_synergy_windows",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "description": "right Cmd tap: Microsoft IME on",
          "from": {
            "key_code": "right_command",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "right_command",
              "lazy": true
            }
          ],
          "to_if_alone": [
            {
              "key_code": "caps_lock",
              "modifiers": [
                "left_control"
              ],
              "hold_down_milliseconds": 100
            },
            {
              "key_code": "vk_none"
            },
            {
              "key_code": "caps_lock",
              "modifiers": [
                "left_control"
              ],
              "hold_down_milliseconds": 100
            },
            {
              "key_code": "vk_none"
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome\\.app\\.cmkncekebbebpfilplodngbpllndjkfo$"
              ]
            },
            {
              "type": "variable_unless",
              "name": "customenter_synergy_windows",
              "value": 1
            }
          ]
        }
      ]
    }
  ]
}
